# ---------------------------------------------------------------------------
# Backend (server-only)
# ---------------------------------------------------------------------------
# Ports match docker-compose.yml, offset so they never clash with a host install.
DATABASE_URL=postgresql://helix:helix@localhost:5434/helix
REDIS_URL=redis://localhost:6381

# Local object storage. Swap server/lib/storage.ts for an S3 adapter in production.
STORAGE_DIR=./.storage

# WebSocket gateway (its own process — Next route handlers cannot take an upgrade).
WS_PORT=3101

# Encrypts outgoing OAuth client secrets and tokens at rest (AES-256-GCM).
# Has a development fallback so a clean checkout runs; set a real value before
# storing any real credential. Rotating it makes existing connections
# undecryptable — which is the correct failure, not a silent one.
ENCRYPTION_SECRET=change-me-before-storing-real-credentials

# Public origin, used to build the webhook URLs shown to administrators.
PUBLIC_URL=http://localhost:3000

# Lets outgoing webhooks, slash commands and OAuth token exchange reach private
# addresses. Off by default: a URL box that reaches the internal network is
# server-side request forgery with a form around it. Local integrations run on
# localhost, so development turns it on deliberately.
OUTBOUND_ALLOW_PRIVATE=true

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
# "true" runs entirely on in-memory fixtures with no backend required.
# "false" talks to the REST API and WebSocket gateway.
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3101

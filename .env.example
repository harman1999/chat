# ---------------------------------------------------------------------------
# Backend (server-only)
# ---------------------------------------------------------------------------
# Ports match docker-compose.yml, offset so they never clash with a host install.
DATABASE_URL=postgresql://helix:helix@localhost:5434/helix
REDIS_URL=redis://localhost:6381

# Local object storage. Swap server/lib/storage.ts for an S3 adapter in production.
STORAGE_DIR=./.storage

# WebSocket gateway (its own process — Next route handlers cannot take an upgrade).
WS_PORT=3101

# Encrypts outgoing OAuth client secrets, tokens and the single sign-on client
# secret at rest (AES-256-GCM). Development has a fallback so a clean checkout
# runs; PRODUCTION REFUSES TO START without a real value of at least 32 random
# characters (`openssl rand -base64 32`). Rotating it makes existing connections
# undecryptable — which is the correct failure, not a silent one.
ENCRYPTION_SECRET=change-me-before-storing-real-credentials

# Public origin, used to build webhook URLs, invite links, emailed links and
# single sign-on addresses. Production requires an https:// address.
PUBLIC_URL=http://localhost:3000

# How many reverse proxies sit in front of the app, each adding the address it
# saw to X-Forwarded-For. The client's address is read that many places from the
# right, because the left of the header is chosen by the client. 0 ignores the
# header entirely — the safe choice when nothing trusted sits in front. Used for
# rate limits, the audit log and the active-sessions list. Defaults to 0 in
# development and 1 in production.
# TRUSTED_PROXY_HOPS=1

# Password hashing and DNS lookups share Node's small worker-thread pool; a
# larger pool leaves headroom for database connections under a sign-in flood.
# UV_THREADPOOL_SIZE=8

# Outgoing mail (password reset, and later invites and notifications).
# Leave SMTP_HOST empty and the features that need mail say it is not set up.
# Development: Mailpit from docker-compose — read what was sent at
# http://localhost:8026. Production: your provider's SMTP details.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Helix <no-reply@helix.local>

# Lets outgoing webhooks, slash commands and OAuth token exchange reach private
# addresses. Off by default: a URL box that reaches the internal network is
# server-side request forgery with a form around it. Local integrations run on
# localhost, so development turns it on deliberately.
OUTBOUND_ALLOW_PRIVATE=true

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
# "true" runs entirely on in-memory fixtures with no backend required.
# "false" talks to the REST API and WebSocket gateway.
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3101
